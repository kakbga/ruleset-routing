# 本地配置文件示例
# 复制此文件为 clash-verge-local.yaml，然后填入你的订阅链接
# clash-verge-local.yaml 已被 .gitignore 忽略，不会上传到 GitHub

# 使用方法：
# 1. cp clash-verge-local.yaml.example clash-verge-local.yaml
# 2. 编辑 clash-verge-local.yaml，替换订阅链接
# 3. 导入 clash-verge-local.yaml 到 Clash Verge Rev

# 订阅链接配置（替换 YOUR_SUBSCRIPTION_URL）：
# proxy-providers:
#   airport1:
#     url: "https://your-airport1-subscription-url"
#   airport2:
#     url: "https://your-airport2-subscription-url"

# Clash Verge Rev 本地订阅示例
# 搭配全局扩展脚本使用；脚本负责生成代理组、规则集和分流规则。
mode: rule

proxies:
  - name: "示例 VMess 节点"
    type: vmess
    server: example.com
    port: 443
    uuid: 00000000-0000-0000-0000-000000000000
    alterId: 0
    cipher: auto
    udp: true
    tls: true
    servername: example.com
    network: ws
    ws-opts:
      path: /your-path
      headers:
        Host: example.com

  - name: "示例 VLESS 节点"
    type: vless
    server: example.com
    port: 443
    uuid: 00000000-0000-0000-0000-000000000000
    encryption: ""
    udp: true
    tls: true
    servername: example.com
    client-fingerprint: chrome
    alpn:
      - http/1.1
    network: ws
    ws-opts:
      path: /your-path
      headers:
        Host: example.com